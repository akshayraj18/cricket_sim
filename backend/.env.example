DATABASE_URL=postgresql+asyncpg://cricket_sim:cricket_sim@localhost:5432/cricket_sim
REDIS_URL=redis://localhost:6379/0

# IMPORTANT for production: set JWT_SECRET to a strong, random value (>=32 chars,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`). The app
# REFUSES to start in production (ENVIRONMENT=production) if this is left as the
# dev default or is too short.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS. Only affects browser callers (the native app sends no Origin). In
# production set an explicit comma-separated allowlist — the "*" default is
# rejected at startup when ENVIRONMENT=production.
CORS_ALLOW_ORIGINS=*

# Rate limiting for the auth endpoints (Redis-backed, per client/minute). Blunts
# credential/token abuse; true network DDoS is handled upstream (CDN/WAF/proxy).
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20

# Observability (Sentry crash/error reporting). Leave SENTRY_DSN blank to
# disable (no events sent — the default for dev/test). Get the DSN from your
# Sentry project (Settings -> Client Keys).
SENTRY_DSN=
ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
