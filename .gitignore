__pycache__/
*.pyc
*.pkl
.venv/
venv/
.env
.env.local
.env.*.local
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Datasets
player_datasets/

# Secrets / credentials (OAuth client secrets, IDs, keys) — never commit
docs/ids.txt
*.secrets
google-services.json
GoogleService-Info.plist

# Editor / tool configs (personal, not needed to build or run)
.vscode/
.claude/
**/.vscode/
**/.claude/

# Local secrets (JWT secret, OAuth IDs) — never commit
secrets/

# App Store marketing screenshots (raw device captures — not source)
cricsimpics/

# Local planning / prep docs — keep out of git
KNOWN_ISSUES.md
APP_STORE_LISTING.md

# Documentation is kept local, not in the repo (planning, design notes, roadmaps).
# `docs/*` does not cross a slash, so docs/legal/ is deliberately NOT matched.
docs/*.md
docs/*.txt
backend/DEPLOY.md

# EXCEPTION -- docs/legal/ MUST stay tracked. GitHub Pages publishes it from
# main:/docs, so these files ARE the live privacy policy and terms: the URLs
# the app links to and the App Store requires. Untracking them takes those
# pages offline. README.md and the per-package READMEs also stay tracked.

# --- Build/tool artifacts and editor leftovers -------------------------------
# Preventive: none of these are in the repo today. Added because the one file
# that did slip in (mobile/.env.local.bak, #54) got through on a suffix the
# rules did not anticipate, and this class of file is never worth committing.

# Node deps anywhere (mobile/ and webapp/ each vendor their own)
node_modules/

# Python tooling caches
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Editor / OS leftovers
*.swp
*.swo
Thumbs.db

# Backups, merge leftovers, and stray logs
*.bak
*.orig
*.rej
*~
*.log
